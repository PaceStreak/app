{
  "name": "PaceStreak",
  "short_name": "PaceStreak",
  "description": "Log the session, keep the streak, watch the grid fill.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#efeeea",
  "theme_color": "#d6281f",
  "categories": [
    "health",
    "fitness",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log a session",
      "short_name": "Log",
      "url": "/log?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-log.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start a live workout",
      "short_name": "Live",
      "url": "/workouts/live?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-live.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Last week's recap",
      "short_name": "Recap",
      "url": "/recap?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-recap.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Progress",
      "url": "/progress?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-progress.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Rest timer",
      "url": "/tools?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-timer.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}

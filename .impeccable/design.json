  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action: lime pill with lime ink.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Save</button>",
      "css": ".ds-btn{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 1.1rem;border-radius:999px;border:1px solid transparent;font-weight:650;font-size:.95rem;line-height:1;cursor:pointer;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--accent-text,#d3ff3e);outline-offset:2px}.ds-btn-primary{background:var(--accent,#d3ff3e);color:var(--accent-ink,#14170a)}.ds-btn-primary:hover{filter:brightness(1.06)}"
    },
    {

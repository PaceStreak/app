  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action: calendar red, square 4px corners.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Save</button>",
      "css": ".ds-btn{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 1.1rem;border-radius:4px;border:1px solid transparent;font-weight:650;font-size:.95rem;line-height:1;cursor:pointer;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--accent-text,#b31d15);outline-offset:2px}.ds-btn-primary{background:var(--accent,#d6281f);color:var(--accent-ink,#fff)}.ds-btn-primary:hover{filter:brightness(1.06)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Paper fill on a printed rule.",
      "html": "<button class=\"ds-btn2\">Archive</button>",
      "css": ".ds-btn2{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;min-height:44px;padding:0 1.1rem;border-radius:4px;border:1px solid var(--line,#dddcd6);background:var(--surface-2,#f1f0eb);color:var(--ink,#141414);font-weight:650;font-size:.95rem;cursor:pointer;transition:background-color 160ms ease,transform 160ms cubic-bezier(.23,1,.32,1)}.ds-btn2:hover{background:var(--surface-3,#e6e5df)}.ds-btn2:active{transform:scale(.97)}.ds-btn2:focus-visible{outline:2px solid var(--accent-text,#b31d15);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "48px field on paper fill; focus turns the rule red.",
      "html": "<label class=\"ds-label\">Habit name<input class=\"ds-input\" placeholder=\"Read 20 pages\"></label>",
      "css": ".ds-label{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:block;font-size:.8125rem;font-weight:600;color:var(--muted,#45454a)}.ds-input{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:block;margin-top:.4rem;width:100%;min-height:48px;padding:0 .95rem;border-radius:4px;background:var(--surface-2,#f1f0eb);border:1px solid var(--line,#dddcd6);color:var(--ink,#141414);font-size:1rem;transition:border-color 160ms ease,background-color 160ms ease}.ds-input::placeholder{color:var(--dim,#5c5c62)}.ds-input:focus{outline:none;border-color:var(--accent-text,#b31d15);background:var(--surface,#fbfbf8)}"
    },
    {
      "name": "Segmented Index Tabs",
      "kind": "nav",
      "description": "Planner section tabs on a ruled ink edge; current tab gets a 3px red bar.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Week</button><button aria-pressed=\"false\">Month</button><button aria-pressed=\"false\">Year</button></div>",
      "css": ".ds-seg{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:grid;grid-auto-flow:column;grid-auto-columns:1fr;border-bottom:1px solid var(--ink,#141414)}.ds-seg button{min-height:38px;border:0;border-radius:0;background:transparent;font:inherit;font-size:.875rem;font-weight:600;color:var(--muted,#45454a);cursor:pointer;transition:color 180ms ease}.ds-seg button:hover{color:var(--ink,#141414)}.ds-seg button:focus-visible{outline:2px solid var(--accent-text,#b31d15);outline-offset:2px}.ds-seg button[aria-pressed=\"true\"]{color:var(--accent-text,#b31d15);font-weight:750;box-shadow:inset 0 -3px 0 var(--accent,#d6281f)}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Square 28px tag; accent variant is a red wash.",
      "html": "<span class=\"ds-chip\">Lv 4</span> <span class=\"ds-chip ds-chip-accent\">3 wk</span>",
      "css": ".ds-chip{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;height:28px;padding:0 .7rem;border-radius:4px;font-size:.8125rem;font-weight:600;background:var(--surface-2,#f1f0eb);color:var(--muted,#45454a);border:1px solid var(--line,#dddcd6)}.ds-chip-accent{background:var(--accent-soft,rgb(214 40 31/.09));color:var(--accent-text,#b31d15);border-color:transparent}"
    },
    {
      "name": "Tear-off Date Block",
      "kind": "card",
      "refersTo": "tearoff-day",
      "description": "Today as a torn calendar page: red weekday band, perforation, condensed day numeral.",
      "html": "<div class=\"ds-tearoff\"><div class=\"ds-th\">Sunday</div><div class=\"ds-td\">27</div><div class=\"ds-tm\">September 2026</div></div>",
      "css": ".ds-tearoff{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:grid;grid-template-rows:auto 1fr auto;width:6.25rem;overflow:hidden;border:1px solid var(--line-lit,#bebdb6);border-radius:4px;background:var(--surface,#fbfbf8);color:var(--ink,#141414);text-align:center}.ds-th{background:var(--accent,#d6281f);color:var(--accent-ink,#fff);font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.3rem 0 .25rem;border-bottom:1px dashed rgb(255 255 255/.45)}.ds-td{font-size:3.4rem;line-height:1;font-weight:850;font-stretch:70%;letter-spacing:-.03em;padding-top:.35rem;font-variant-numeric:tabular-nums}.ds-tm{font-size:.78rem;font-weight:600;color:var(--muted,#45454a);padding-bottom:.45rem}"
    },
    {
      "name": "Week Board Row",
      "kind": "custom",
      "refersTo": "board-day",
      "description": "One habit, seven ruled date boxes; today outlined red; done days crossed off in the habit's marker.",
      "html": "<div class=\"ds-board\"><div class=\"ds-bn\">Read 20 pages <span>3/5</span></div><button class=\"ds-bd\"><span class=ds-faded>21</span><span style=\"color:#1f5fbf\"><svg viewBox=\"0 0 40 40\" class=\"ds-marker\" aria-hidden=\"true\"><path class=\"ds-stroke\" pathLength=\"1\" d=\"M8.5 9.5c6.5 5.4 15 13.2 23 21.8\"/><path class=\"ds-stroke ds-stroke-2\" pathLength=\"1\" d=\"M31.5 8.8C24 15 16.4 22.3 8.8 31\"/></svg></span></button><button class=\"ds-bd\"><span>22</span></button><button class=\"ds-bd\"><span class=ds-faded>23</span><span style=\"color:#1f5fbf\"><svg viewBox=\"0 0 40 40\" class=\"ds-marker\" aria-hidden=\"true\"><path class=\"ds-stroke\" pathLength=\"1\" d=\"M8.5 9.5c6.5 5.4 15 13.2 23 21.8\"/><path class=\"ds-stroke ds-stroke-2\" pathLength=\"1\" d=\"M31.5 8.8C24 15 16.4 22.3 8.8 31\"/></svg></span></button><button class=\"ds-bd\"><span>24</span></button><button class=\"ds-bd\"><span class=ds-faded>25</span><span style=\"color:#1f5fbf\"><svg viewBox=\"0 0 40 40\" class=\"ds-marker\" aria-hidden=\"true\"><path class=\"ds-stroke\" pathLength=\"1\" d=\"M8.5 9.5c6.5 5.4 15 13.2 23 21.8\"/><path class=\"ds-stroke ds-stroke-2\" pathLength=\"1\" d=\"M31.5 8.8C24 15 16.4 22.3 8.8 31\"/></svg></span></button><button class=\"ds-bd\"><span>26</span></button><button class=\"ds-bd\" data-today><span>27</span></button></div>",
      "css": ".ds-board{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border:1px solid var(--line,#dddcd6);border-radius:4px;background:var(--surface,#fbfbf8);color:var(--ink,#141414)}.ds-bn{grid-column:1/-1;display:flex;justify-content:space-between;padding:.6rem .75rem .4rem;font-size:.95rem;font-weight:600}.ds-bn span{font-size:.75rem;color:var(--dim,#5c5c62);font-stretch:82%;font-variant-numeric:tabular-nums}.ds-bd{position:relative;display:grid;place-items:center;height:3rem;border:0;border-top:1px solid var(--line,#dddcd6);border-left:1px solid var(--line,#dddcd6);background:transparent;font:inherit;font-size:.85rem;font-weight:600;font-stretch:80%;color:var(--dim,#5c5c62);cursor:pointer;transition:background-color 160ms ease}.ds-bd:nth-of-type(1){border-left:0}.ds-bd:hover:not(:disabled){background:var(--surface-2,#f1f0eb)}.ds-bd:focus-visible{outline:2px solid var(--accent-text,#b31d15);outline-offset:-2px}.ds-bd[data-today]{background:var(--accent-soft,rgb(214 40 31/.09));color:var(--accent-text,#b31d15);box-shadow:inset 0 0 0 1.5px var(--accent,#d6281f)}.ds-bd:disabled{color:rgb(92 92 98/.45);cursor:default}.ds-faded{opacity:.35}.ds-marker{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.ds-stroke{fill:none;stroke:currentColor;stroke-width:4.6;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0;opacity:.94;animation:ds-draw 150ms cubic-bezier(.3,.6,.2,1) both}.ds-stroke-2{animation-delay:120ms}@keyframes ds-draw{from{stroke-dashoffset:1}}@media (prefers-reduced-motion:reduce){.ds-stroke{animation:none}}"
    },
    {
      "name": "Tick Box",
      "kind": "custom",
      "refersTo": "tick-box",
      "description": "The one way done looks: a printed box crossed off with the marker X.",
      "html": "<span class=\"ds-tick\"></span> <span class=\"ds-tick\"><svg viewBox=\"0 0 40 40\" class=\"ds-marker\" style=\"color:#d6281f\" aria-hidden=\"true\"><path class=\"ds-stroke\" pathLength=\"1\" d=\"M8.5 9.5c6.5 5.4 15 13.2 23 21.8\"/><path class=\"ds-stroke ds-stroke-2\" pathLength=\"1\" d=\"M31.5 8.8C24 15 16.4 22.3 8.8 31\"/></svg></span>",
      "css": ".ds-tick{position:relative;display:inline-block;width:20px;height:20px;border-radius:2px;border:1.5px solid rgb(20 20 20/.7);background:var(--surface,#fbfbf8);vertical-align:middle}.ds-marker{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.ds-stroke{fill:none;stroke:currentColor;stroke-width:4.6;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0;opacity:.94;animation:ds-draw 150ms cubic-bezier(.3,.6,.2,1) both}.ds-stroke-2{animation-delay:120ms}@keyframes ds-draw{from{stroke-dashoffset:1}}@media (prefers-reduced-motion:reduce){.ds-stroke{animation:none}}"
    },
    {
      "name": "Log Marker Cap",
      "kind": "button",
      "refersTo": "log-cap",
      "description": "The Log button as a felt-tip cap: squared red cap, darker clip band, cut out of the tab-bar rule by a paper ring.",
      "html": "<button class=\"ds-cap\" aria-label=\"Log\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 256 256\" fill=\"currentColor\"><path d=\"M228 128a12 12 0 0 1-12 12h-76v76a12 12 0 0 1-24 0v-76H40a12 12 0 0 1 0-24h76V40a12 12 0 0 1 24 0v76h76a12 12 0 0 1 12 12Z\"/></svg></button>",
      "css": ".ds-cap{display:grid;place-items:center;width:56px;height:56px;border:0;border-radius:6px 6px 4px 4px;background:var(--accent,#d6281f);color:var(--accent-ink,#fff);cursor:pointer;box-shadow:0 0 0 4px var(--bg,#fbfbf8),inset 0 -9px 0 color-mix(in srgb,var(--ink,#141414) 22%,var(--accent,#d6281f));transition:transform 160ms cubic-bezier(.23,1,.32,1)}.ds-cap:active{transform:scale(.985)}.ds-cap:focus-visible{outline:2px solid var(--accent-text,#b31d15);outline-offset:6px}"
    }
  ],
  "narrative": {
    "northStar": "The Wall Calendar Chain",
    "overview": "**Creative North Star: \"The Wall Calendar Chain\"**\n\nPaceStreak is a printed wall calendar crossed off in felt-tip marker. The surface is bright coated calendar paper, not cream; type and rules are hard black print; the one loud colour is printed calendar red, the red a calendar uses for today and Sundays. Habits are drawn in a small felt-tip set, so each habit's X comes out of its own marker. Dark mode isn't a neon dashboard. It's the same calendar at night under a desk lamp: charcoal paper with chalk-white ink and a warmer, brighter red.\n\nThe density is a calendar grid: 1px printed rules, square boxes, condensed heavy numerals for every date and count, and normal-width Archivo for reading. Depth comes from print, not light. There are no card shadows. Surfaces are separated by rules and slight paper tints. The one authored motion is the marker stroke. When a box is ticked, a hand-drawn X draws itself across the date in two strokes. It's slightly uneven on purpose, so it reads as a hand's mark and not a UI checkmark.\n\nThe world refuses the category default of rounded cards, progress rings and a dark neon dashboard. The old lime-on-near-black look is retired completely.",
    "keyCharacteristics": [
      "Coated paper (#fbfbf8) and black print ink (#141414); calendar red reserved for today, Sundays, the streak and the primary action.",
      "A felt-tip marker set (red, blue, green, orange, violet) assigned to habits by category.",
      "1px printed grid rules, square 4px corners, no shadows.",
      "Archivo variable: condensed (70-88% width) and heavy for numerals and headings, 100% width for text.",
      "A marker X drawn in two strokes (150ms each, the second 120ms later) is the only signature motion."
    ],
    "rules": [
      {
        "name": "The Calendar Red Rule",
        "body": "Red marks what a printed calendar marks in red: today, Sundays, the streak, and the one action that crosses a day off. It is never decoration and never a second accent.",
        "section": "colors"
      },
      {
        "name": "The Measured Grey Rule",
        "body": "Every muted text colour is measured against the paper it sits on. Dim is the lightest grey allowed (6.1:1 light, 5.9:1 dark).",
        "section": "colors"
      },
      {
        "name": "The Printed Numeral Rule",
        "body": "Every date, count and measure is condensed and tabular (`.num`: 82% width, tabular-nums), so columns line up like a printed grid.",
        "section": "typography"
      },
      {
        "name": "The Print, Not Light Rule",
        "body": "Nothing casts a shadow. If something needs to sit above something else, give it a rule or a tint.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do separate surfaces with a 1px printed rule and a paper tint, never a shadow.",
      "Do mark done with a MarkerX drawn in the habit's category marker, and keep the date visible underneath at reduced opacity.",
      "Do set every date and count in condensed, tabular Archivo (`.num`).",
      "Do keep calendar red for today, Sundays, the streak and the Log action.",
      "Do define every colour in both the paper theme and the desk-lamp theme.",
      "Do keep the marker stroke as the one authored motion, and show it instantly under reduced motion."
    ],
    "donts": [
      "Don't add card shadows, glows or progress rings. The world is print.",
      "Don't round corners past 4px on cards, controls or boxes; the marker cap's 6px top is the one exception, because a real cap has it.",
      "Don't bring back the old lime-on-near-black palette, and don't treat dark mode as a neon dashboard. Dark is the same calendar under a desk lamp.",
      "Don't invent a second \"done\" mark. The tick box and board both use the marker X.",
      "Don't use a grey lighter than print-ink-dim for text."
    ]
  }
}
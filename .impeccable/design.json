      "css": ".ds-btn2{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 1.1rem;border-radius:999px;border:1px solid transparent;font-weight:650;font-size:.95rem;line-height:1;cursor:pointer;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms ease;background:var(--surface-2,#1a1a1e);border-color:var(--line,#26262c);color:var(--ink,#f4f4f5)}.ds-btn2:hover{background:var(--surface-3,#222228)}.ds-btn2:active{transform:scale(.97)}.ds-btn2:focus-visible{outline:2px solid var(--accent-text,#d3ff3e);outline-offset:2px}"
    },
    {

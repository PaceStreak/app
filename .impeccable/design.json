      "css": ".ds-label{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:block;font-size:.8125rem;font-weight:600;color:var(--muted,#a1a1aa)}.ds-input{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:block;box-sizing:border-box;margin-top:.4rem;width:100%;min-height:48px;padding:0 .95rem;border-radius:12px;background:var(--surface-2,#1a1a1e);border:1px solid var(--line,#26262c);color:var(--ink,#f4f4f5);font-size:1rem;transition:border-color 160ms ease,background-color 160ms ease}.ds-input::placeholder{color:var(--dim,#8b8b95)}.ds-input:focus{outline:none;border-color:var(--accent-text,#d3ff3e);background:var(--surface,#141417)}"

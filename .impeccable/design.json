      "html": "<div class=\"ds-tearoff\"><div class=\"ds-th\">Sun</div><div class=\"ds-td\">27</div><div class=\"ds-tm\">Sep</div></div>",
      "css": ".ds-tearoff{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:grid;grid-template-rows:auto 1fr auto;width:6.25rem;overflow:hidden;border:1px solid var(--line-lit,#34343d);border-radius:14px;background:var(--surface,#141417);color:var(--ink,#f4f4f5);text-align:center;box-shadow:var(--shadow,0 1px 0 rgb(255 255 255/.04) inset,0 12px 32px -12px rgb(0 0 0/.6))}.ds-th{background:var(--accent,#d3ff3e);color:var(--accent-ink,#14170a);font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.3rem 0 .25rem;border-bottom:1px dashed color-mix(in srgb,var(--accent-ink,#14170a) 45%,transparent)}.ds-td{font-size:3.4rem;line-height:1;font-weight:850;font-stretch:70%;letter-spacing:-.03em;padding-top:.35rem;font-variant-numeric:tabular-nums}.ds-tm{font-size:.78rem;font-weight:600;color:var(--muted,#a1a1aa);padding-bottom:.45rem}"

      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Week</button><button aria-pressed=\"false\">Month</button><button aria-pressed=\"false\">Year</button></div>",
      "css": ".ds-seg{font-family:\"Archivo Variable\",ui-sans-serif,system-ui,sans-serif;display:grid;grid-auto-flow:column;grid-auto-columns:1fr;padding:4px;gap:4px;border-radius:999px;background:var(--surface-2,#1a1a1e);border:1px solid var(--line,#26262c)}.ds-seg button{min-height:36px;border:0;border-radius:999px;background:transparent;font:inherit;font-size:.875rem;font-weight:600;color:var(--muted,#a1a1aa);cursor:pointer;transition:background-color 180ms cubic-bezier(.23,1,.32,1),color 180ms ease}.ds-seg button:hover{color:var(--ink,#f4f4f5)}.ds-seg button:focus-visible{outline:2px solid var(--accent-text,#d3ff3e);outline-offset:2px}.ds-seg button[aria-pressed=\"true\"]{background:var(--surface,#141417);color:var(--ink,#f4f4f5);box-shadow:var(--shadow,0 1px 0 rgb(255 255 255/.04) inset,0 12px 32px -12px rgb(0 0 0/.6))}"

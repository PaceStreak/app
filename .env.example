# Copy to .env for local development. Never commit the copy.
#
# Real values are set as environment variables on the Cloudflare Pages project,
# not in this repository. Anything prefixed PUBLIC_ is inlined into the client
# bundle by the build and is therefore public — do not put a secret behind that
# prefix.

# Base URL of the backend. Local development points at a local API; the
# deployed build points at the real one.
PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile site key (public by design - the secret key lives on
# the API only, see api/.env.example). Unset, the widget never renders and
# forms submit with no token, which the API accepts as long as it also has no
# TURNSTILE_SECRET_KEY set.
PUBLIC_TURNSTILE_SITE_KEY=
